# FinPremium — backend
# Copie este arquivo para backend/.env e preencha com os valores REAIS.
# O .env real NÃO vai para o git (já está no .gitignore).
# Peça os valores reais ao responsável por um canal seguro (1Password/Bitwarden/DM).

# --- Banco de dados (MongoDB Atlas) ---
MONGO_URL=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=finpremium

# --- Frontend (CORS + cookies) ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Auth ---
JWT_SECRET=gere_uma_string_aleatoria_forte
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=defina_uma_senha_forte
COOKIE_SECURE=false

# --- Email (Resend) — https://resend.com/api-keys ---
RESEND_API_KEY=re_xxxxxxxx
SENDER_EMAIL=onboarding@resend.dev
OWNER_EMAIL=seu-email@exemplo.com

# --- Stripe — use sk_test_... localmente ---
STRIPE_API_KEY=sk_test_xxxxxxxx
# Rode `stripe listen --forward-to localhost:8000/api/webhook/stripe` e cole o whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Twilio WhatsApp Sandbox ---
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_SMS_NUMBER=+1xxxxxxxxxx

# --- Emergent AI (opcional) ---
EMERGENT_AI_URL=
EMERGENT_AI_API_KEY=

# --- Visão para recibos/notas (Gemini OU OpenAI) ---
GEMINI_API_KEY=xxxxxxxx
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- Preenchido automaticamente ao subir o tunnel (sandbox WhatsApp) ---
TWILIO_WEBHOOK_PUBLIC_URL=

# --- Direct Data (Análise de Crédito / Rating Avançado) ---
# Provider plugável: "directdata" (produção) | "mock" (dev, não gasta crédito)
CREDIT_PROVIDER=directdata
# Token único da conta Direct Data (gerado na plataforma). NÃO vai ao frontend.
DIRECTD_TOKEN=xxxxxxxx
DIRECTD_BASE_URL=https://apiv3.directd.com.br
DIRECTD_TIMEOUT=45
#
# Consultas do relatório. Os paths abaixo são os padrões do código — só
# preencha um ENDPOINT se precisar sobrescrever. Custo por consulta (V5.3):
#   Score de Crédito QUOD .......... /api/Score ...................... R$ 1,98
#   SCR Detalhada BACEN ............ /api/SCRBacenDetalhada .......... R$ 4,90
#   Detalhamento Negativo QUOD ..... /api/DetalhamentoNegativo ....... R$ 2,38
#   Dívida ativa da União (PGFN) ... /api/PGFNListaDevedoresUniao .... R$ 0,36
# Total ≈ R$ 9,62. Cadastro PF Plus (renda/situação) foi removido.
# A consulta usa SOMENTE o CPF cadastrado na conta do usuário (set-once).
#
# Competência do SCR (formato MMAAAA, ou "atual"). Deixe VAZIO: o BACEN fecha o
# SCR mensalmente com defasagem, então pedir o mês corrente faz a consulta ser
# recusada. Vazio = a Direct Data devolve a competência mais recente disponível.
DIRECTD_SCR_MESANO=
#
# Negativações: PEFIN/REFIN, protestos (só SP), ações judiciais, falência e
# cheques sem fundo. Desligue para economizar; o relatório sai só com Score + SCR.
DIRECTD_PENDENCIAS_ENABLED=true
DIRECTD_PENDENCIAS_ENDPOINT=
# Dívida ativa da União — dívida com a Receita/PGFN, fora do SCR e dos bureaus.
DIRECTD_DIVIDA_ATIVA_ENABLED=true
DIRECTD_DIVIDA_ATIVA_ENDPOINT=
# Preço de referência do pacote completo (BRL). O avulso cobra proporcional às
# APIs escolhidas: custo Direct Data × CREDIT_PRICE_MARGIN (piso em MIN_PRICE).
CREDIT_REPORT_PRICE_BRL=39.90
CREDIT_PRICE_MARGIN=4.15
CREDIT_REPORT_MIN_PRICE_BRL=9.90
# CPF obrigatório no cadastro. Em teste (USE_MOCK_DB / APP_ENV=test) e no admin,
# a exigência é relaxada. Em produção deixe true/omitido.
REQUIRE_CPF_ON_REGISTER=true
# Retenção do relatório (dias) antes de expirar (LGPD). Aplicada por índice TTL
# na coleção credit_reports — o Mongo apaga sozinho. 0 desliga a expiração.
CREDIT_REPORT_RETENTION_DAYS=90
# Horas até apagar o CPF cifrado de um pedido abandonado (checkout nunca pago).
# A sessão do Stripe expira em 24h, então 48h já dá margem de sobra.
CREDIT_ORDER_DOC_TTL_HOURS=48
# Versão do texto de consentimento registrado na credit_orders (LGPD).
CREDIT_CONSENT_VERSION=v1
# Chave Fernet para cifrar o documento entre o checkout e a geração do relatório.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, é derivada do JWT_SECRET (ok para dev; defina uma própria em produção).
CREDIT_DOC_ENC_KEY=
